# Rust shadow server
XPDE_BIND=127.0.0.1:8787
XPDE_DB_PATH=data/xpde.sqlite

# Optional read-only MCP (STDIO; it never opens a network listener).
XPDE_API_BASE=http://127.0.0.1:8787
XPDE_ARTIFACT_ROOT=artifacts/catboost
XPDE_MCP_TIMEOUT_SECONDS=5

# Optional MetaTrader 5 terminal selection.
# Leave login/password/server unset to use the account already logged into
# the local terminal. Never commit the real values.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_UTC_OFFSET_OVERRIDE_HOURS=
# Defaults to MT5_UTC_OFFSET_OVERRIDE_HOURS and interprets the weekly broker
# session calendar in config/default.toml.
MT5_MARKET_UTC_OFFSET_HOURS=
# Optional comma-separated YYYY-MM-DD emergency holiday/maintenance closures.
XPDE_MARKET_CLOSED_DATES=
